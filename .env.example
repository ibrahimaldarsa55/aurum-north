# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Your production URL (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.ca

# Contact form email delivery via Resend (https://resend.com).
# Leave these unset and the form falls back to opening the visitor's email app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.ca
# Must be on a domain you have verified in Resend
CONTACT_FROM_EMAIL="Aurum North <hello@yourdomain.ca>"
